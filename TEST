retrait_df = retrait_raw.withColumn(
    "bin_clean",
    F.when(F.substring(F.col("num_carte"), 7, 2) == "XX",
           F.substring(F.col("num_carte"), 1, 6))
     .otherwise(F.substring(F.col("num_carte"), 1, 8))
).withColumn(
    "bin_clean_num",
    F.col("bin_clean").cast(LongType())
).withColumn(
    "bin_type",
    F.when(F.substring(F.col("num_carte"), 7, 2) == "XX", F.lit(6))
     .otherwise(F.lit(8))
     .cast(IntegerType())
)
 
# ------------------------------------------------------------
# PREPARATION TABLE BINs (avec colonne pays) — PAS d'explosion
# ------------------------------------------------------------
bin_filtered = bin_raw.filter(
    (F.col("pi_daeffet") < "2026-01-01") & (F.col("pi_dafin") > "2025-12-31")
).withColumn(
    "bin6_min", F.substring(F.col("pi_trmin"), 1, 6).cast(LongType())
).withColumn(
    "bin6_max", F.substring(F.col("pi_trmax"), 1, 6).cast(LongType())
).withColumn(
    "bin8_min", F.substring(F.col("pi_trmin"), 1, 8).cast(LongType())
).withColumn(
    "bin8_max", F.substring(F.col("pi_trmax"), 1, 8).cast(LongType())
).select(
    "bin6_min", "bin6_max", "bin8_min", "bin8_max",
    # Code pays sur 3 caracteres (ex: FRA, USA, BRA, CHL, RUS...)
    F.upper(F.trim(F.col(COL_PAYS).cast("string"))).alias("pays")
).filter(
    F.col("bin6_min").isNotNull() & F.col("bin6_max").isNotNull() &
    F.col("bin8_min").isNotNull() & F.col("bin8_max").isNotNull()
)
 
# Table de reference BIN generalement petite (quelques milliers a
# quelques centaines de milliers de lignes) -> broadcast pour eviter
# un shuffle sur la grosse table de transactions
bin_broadcast = F.broadcast(bin_filtered)
 
# ------------------------------------------------------------
# JOINTURE PAR INTERVALLE
# bin_type=6 -> comparaison sur bin6_min/bin6_max
# bin_type=8 -> comparaison sur bin8_min/bin8_max
# ------------------------------------------------------------
join_condition = (
    (
        (retrait_df["bin_type"] == 6) &
        (retrait_df["bin_clean_num"] >= bin_broadcast["bin6_min"]) &
        (retrait_df["bin_clean_num"] <= bin_broadcast["bin6_max"])
    ) | (
        (retrait_df["bin_type"] == 8) &
        (retrait_df["bin_clean_num"] >= bin_broadcast["bin8_min"]) &
        (retrait_df["bin_clean_num"] <= bin_broadcast["bin8_max"])
    )
)
 
result = retrait_df.join(bin_broadcast, join_condition, how="left")
 
# ------------------------------------------------------------
# FLAG ETRANGER : pays different de FRA
# NB : si le BIN n'a pas ete trouve dans la table de reference
# (pays NULL), le flag reste NULL -> a traiter en aval comme
# "inconnu", ne pas le confondre avec "francais"
# ------------------------------------------------------------
result = result.withColumn(
    "flag_etranger",
    F.when(F.col("pays").isNull(), F.lit(None).cast(IntegerType()))
     .when(F.col("pays") == "FRA", F.lit(0))
     .otherwise(F.lit(1))
)
 
result = result.drop(
    "bin_clean_num", "bin6_min", "bin6_max", "bin8_min", "bin8_max"
).withColumn(
    "pays", F.col("pays").cast("string")
).withColumn(
    "flag_etranger", F.col("flag_etranger").cast("int")
)
