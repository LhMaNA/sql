import dataiku
from dataiku import spark as dkuspark
from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.types import LongType, ArrayType, IntegerType
from pyspark.sql.functions import udf, col, explode
from pyspark import SparkConf

# TODO A CONFIRMER : nom exact de la colonne pays dans t_lbp_mon_bin8_h
COL_PAYS = "PI_CDPAYS_PLACEHOLDER"

config = SparkConf().setAll([
    ('spark.sql.adaptive.enabled', 'true'),
    ('spark.sql.adaptive.coalescePartitions.enabled', 'true'),
    ('spark.sql.shuffle.partitions', '400'),
    ('spark.executor.instances', '40'),
    ('spark.executor.cores', '4'),
    ('spark.executor.memory', '8g'),
    ('spark.executor.memoryOverhead', '4g'),
])

spark = SparkSession.builder.config(conf=config).enableHiveSupport().getOrCreate()

# ------------------------------------------------------------
# UDF — genere la liste des buckets (prefixe 2 chiffres) couverts
# par une plage. Bornee a 100 valeurs max (00 a 99) donc aucun
# risque d'explosion memoire, contrairement a l'explosion des
# valeurs BIN completes.
# ------------------------------------------------------------
def bucket_range(bucket_min, bucket_max):
    if bucket_min is None or bucket_max is None:
        return []
    return [int(x) for x in range(int(bucket_min), int(bucket_max) + 1)]

bucket_range_udf = udf(bucket_range, ArrayType(IntegerType()))

retrait = dkuspark.get_dataframe(spark, dataiku.Dataset("ds_..."))
bin_ref = dkuspark.get_dataframe(spark, dataiku.Dataset("t_lbp_mon_bin8_h"))

retrait = retrait.filter(F.col("annee").isin(2025, 2026))

# ------------------------------------------------------------
# TABLE RETRAITS : bin_clean, bin_type, bucket (2 premiers chiffres)
# ------------------------------------------------------------
retrait = retrait.withColumn(
    "bin_clean",
    F.when(F.substring(F.col("num_carte"), 7, 2) == "XX", F.substring(F.col("num_carte"), 1, 6))
     .otherwise(F.substring(F.col("num_carte"), 1, 8))
)
retrait = retrait.withColumn("bin_clean", F.col("bin_clean").cast(LongType()))
retrait = retrait.withColumn(
    "bin_type",
    F.when(F.substring(F.col("num_carte"), 7, 2) == "XX", F.lit(6)).otherwise(F.lit(8))
)
retrait = retrait.withColumn("bucket", F.substring(F.col("bin_clean").cast("string"), 1, 2).cast(IntegerType()))
retrait = retrait.repartition(400, "bucket")
retrait.cache()

# ------------------------------------------------------------
# TABLE BIN : plages + bucket_min/bucket_max (prefixe 2 chiffres du min/max)
# ------------------------------------------------------------
bin_ref = bin_ref.filter(
    (F.col("pi_daeffet") < "2026-01-01") & (F.col("pi_dafin") > "2025-12-31")
)
bin_ref = bin_ref.withColumn("bin6_min", F.substring(F.col("pi_trmin"), 1, 6).cast(LongType()))
bin_ref = bin_ref.withColumn("bin6_max", F.substring(F.col("pi_trmax"), 1, 6).cast(LongType()))
bin_ref = bin_ref.withColumn("bin8_min", F.substring(F.col("pi_trmin"), 1, 8).cast(LongType()))
bin_ref = bin_ref.withColumn("bin8_max", F.substring(F.col("pi_trmax"), 1, 8).cast(LongType()))
bin_ref = bin_ref.withColumn("pays", F.upper(F.trim(F.col(COL_PAYS).cast("string"))))

# ------------------------------------------------------------
# JOINTURE BIN6
# ------------------------------------------------------------
bin_6 = bin_ref.select(
    F.substring(F.col("bin6_min").cast("string"), 1, 2).cast(IntegerType()).alias("bucket_min"),
    F.substring(F.col("bin6_max").cast("string"), 1, 2).cast(IntegerType()).alias("bucket_max"),
    "bin6_min", "bin6_max", "pays"
)
bin_6 = bin_6.withColumn("bucket", explode(bucket_range_udf(col("bucket_min"), col("bucket_max"))))
bin_6 = bin_6.select("bucket", "bin6_min", "bin6_max", "pays")

retrait_6 = retrait.filter(F.col("bin_type") == 6)
result_6 = retrait_6.join(bin_6, on="bucket", how="left")
result_6 = result_6.filter(
    F.col("pays").isNull() | ((F.col("bin_clean") >= F.col("bin6_min")) & (F.col("bin_clean") <= F.col("bin6_max")))
)
result_6 = result_6.drop("bin6_min", "bin6_max")

# ------------------------------------------------------------
# JOINTURE BIN8
# ------------------------------------------------------------
bin_8 = bin_ref.select(
    F.substring(F.col("bin8_min").cast("string"), 1, 2).cast(IntegerType()).alias("bucket_min"),
    F.substring(F.col("bin8_max").cast("string"), 1, 2).cast(IntegerType()).alias("bucket_max"),
    "bin8_min", "bin8_max", "pays"
)
bin_8 = bin_8.withColumn("bucket", explode(bucket_range_udf(col("bucket_min"), col("bucket_max"))))
bin_8 = bin_8.select("bucket", "bin8_min", "bin8_max", "pays")

retrait_8 = retrait.filter(F.col("bin_type") == 8)
result_8 = retrait_8.join(bin_8, on="bucket", how="left")
result_8 = result_8.filter(
    F.col("pays").isNull() | ((F.col("bin_clean") >= F.col("bin8_min")) & (F.col("bin_clean") <= F.col("bin8_max")))
)
result_8 = result_8.drop("bin8_min", "bin8_max")

# ------------------------------------------------------------
# UNION + FLAG ETRANGER
# ------------------------------------------------------------
result = result_6.unionByName(result_8).drop("bucket")

result = result.withColumn(
    "flag_etranger",
    F.when(F.col("pays").isNull(), F.lit(None).cast(IntegerType()))
     .when(F.col("pays") == "FRA", F.lit(0))
     .otherwise(F.lit(1))
)

# ------------------------------------------------------------
# SORTIE
# ------------------------------------------------------------
output = dataiku.Dataset("NOM_DATASET_SORTIE_PAYS")
output.write_schema_from_dataframe(result, dropAndCreate=True)
dkuspark.write_with_schema(output, result)
