# Feature engineering
# ══════════════════════════════════════════════════════════════════════════════
df['ratio_capture'] = df['cap_nb'] / (df['ret_nb_horscos'] + 1)
df['cv_montant'] = df['ret_montant_stddev'] / (df['ret_montant_moyen'] + 0.01)

COLS_RESEAU = [c for c in df.columns if c.startswith('nb_ope_reseau_')]
COLS_ETRANGERS = [c for c in COLS_RESEAU if any(x in c for x in ['jcb', 'amex', 'diners', 'cup'])]
df['nb_ope_total_reseau'] = df[COLS_RESEAU].sum(axis=1)
df['concentration_reseau'] = df[COLS_RESEAU].max(axis=1) / (df['nb_ope_total_reseau'] + 1)
df['pct_reseaux_etrangers'] = df[COLS_ETRANGERS].sum(axis=1) / (df['nb_ope_total_reseau'] + 1) * 100

df['log_ret_nb_horscos'] = np.log1p(df['ret_nb_horscos'])

# 'un peu de retrait etranger' compte, pas besoin d'un taux enorme - mais
# pct_reseaux_etrangers est ecrase pres de 0 (tres peu de retraits etrangers en
# general, confirme par le metier). Le log ramene un GAB avec ne serait-ce que
# quelques retraits JCB/Amex/CUP/Diners a un niveau VISIBLEMENT different de la
# masse a 0%, sans avoir besoin d'un taux enorme pour se distinguer.
df['log_pct_reseaux_etrangers'] = np.log1p(df['pct_reseaux_etrangers'])

print('Variables ajoutees : ratio_capture, cv_montant, concentration_reseau, '
      'pct_reseaux_etrangers, log_pct_reseaux_etrangers, log_ret_nb_horscos')
df[['ratio_capture', 'cv_montant', 'concentration_reseau',
    'pct_reseaux_etrangers', 'log_pct_reseaux_etrangers']].describe().round(2)

































