# ══════════════════════════════════════════════════════════════════════════════
# Nommage hybride - 4 familles, chacune avec un critere ANCRE obligatoire
# ══════════════════════════════════════════════════════════════════════════════
VOCABULAIRE_TRAITS = {
    'ret_pct_nuit':              ('Nocturne', 'Diurne marque'),
    'ret_pct_weekend':            ('Forte activite week-end', 'Activite semaine dominante'),
    'log_pct_reseaux_etrangers':  ('Touristique / reseaux etrangers', 'Clientele locale exclusive'),
    'log_ret_nb_horscos':         ('Urbain forte activite', 'Faible activite'),
    'ret_montant_moyen':      ('Montants eleves', 'Petits montants'),
    'taux_capture_pct':           ('Captures frequentes (a surveiller)', 'Captures rares'),
    'cv_montant':                 ('Activite tres instable', 'Activite tres reguliere'),
    'concentration_reseau':       ('Mono-reseau dominant', 'Reseaux diversifies'),
}

SEUIL_TRAIT_DISTINCTIF = 0.3
SEUIL_ISOLE_VOLUME = 1.0
SEUIL_PROXIMITE_MOYENNE = 0.4

FAMILLES_CANDIDATES = {
    'Urbaine': [
        ('log_ret_nb_horscos', 1), ('ret_montant_moyen', 1), ('cv_montant', -1),
    ],
    'Touristique': [
        ('log_pct_reseaux_etrangers', 1), ('ret_pct_weekend', 1), ('ret_pct_nuit', 1),
    ],
    'Isolee': [
        ('log_ret_nb_horscos', -1, SEUIL_ISOLE_VOLUME),
        ('log_pct_reseaux_etrangers', -1), ('cv_montant', -1),
    ],
    'Intermediaire / Periurbaine': [
        ('log_ret_nb_horscos', 0, SEUIL_PROXIMITE_MOYENNE),
        ('ret_montant_moyen', 0, SEUIL_PROXIMITE_MOYENNE),
        ('log_pct_reseaux_etrangers', 0, SEUIL_PROXIMITE_MOYENNE),
    ],
}
SEUIL_MATCH_CANDIDATE = 2

# Critere ANCRE obligatoire : un cluster ne peut porter ce nom que si AU MOINS
# une des alternatives listees est verifiee - empeche "Urbaine" d'apparaitre sans
# volume eleve, ou "Touristique" sans le moindre signal de reseaux etrangers.
CRITERES_OBLIGATOIRES = {
    'Urbaine': [('log_ret_nb_horscos', 1)],
    'Touristique': [('log_pct_reseaux_etrangers', 1)],
    'Isolee': [('log_ret_nb_horscos', -1, SEUIL_ISOLE_VOLUME)],
}

profil_moyen = df.groupby('cluster')[FEAT_CLUST].mean()
z_profil = (profil_moyen - df[FEAT_CLUST].mean()) / df[FEAT_CLUST].std()


def nom_automatique(cid):
    z_row = z_profil.loc[cid]
    ordre = z_row.abs().sort_values(ascending=False).index
    z_tries = z_row.reindex(ordre)
    traits = [(feat, val) for feat, val in z_tries.items()
              if abs(val) >= SEUIL_TRAIT_DISTINCTIF and feat in VOCABULAIRE_TRAITS][:2]
    if not traits:
        return 'Standard'
    morceaux = []
    for feat, val in traits:
        libelle_haut, libelle_bas = VOCABULAIRE_TRAITS[feat]
        morceaux.append(libelle_haut if val > 0 else libelle_bas)
    return ' + '.join(morceaux)


def _critere_satisfait(z_row, critere):
    feat, signe_attendu = critere[0], critere[1]
    if feat not in z_row.index:
        return False
    z_val = z_row[feat]
    if signe_attendu == 0:
        seuil = critere[2] if len(critere) > 2 else SEUIL_PROXIMITE_MOYENNE
        return abs(z_val) < seuil
    seuil = critere[2] if len(critere) > 2 else SEUIL_TRAIT_DISTINCTIF
    return abs(z_val) >= seuil and np.sign(z_val) == signe_attendu


def score_famille_candidate(cid, nom_famille, criteres):
    z_row = z_profil.loc[cid]
    ancres = CRITERES_OBLIGATOIRES.get(nom_famille)
    if ancres and not any(_critere_satisfait(z_row, a) for a in ancres):
        return (0, 0.0)
    n_ok, somme = 0, 0.0
    for critere in criteres:
        if _critere_satisfait(z_row, critere):
            n_ok += 1
            feat = critere[0]
            if critere[1] == 0:
                seuil = critere[2] if len(critere) > 2 else SEUIL_PROXIMITE_MOYENNE
                somme += (seuil - abs(z_row[feat]))
            else:
                somme += abs(z_row[feat])
    return (n_ok, somme)


meilleur_candidat_par_cluster = {}
for cid in range(K_RETENU):
    scores = {nom: score_famille_candidate(cid, nom, criteres)
              for nom, criteres in FAMILLES_CANDIDATES.items()}
    meilleur_nom = max(scores, key=scores.get)
    meilleur_candidat_par_cluster[cid] = (meilleur_nom, scores[meilleur_nom])

ordre_affectation = sorted(range(K_RETENU),
                            key=lambda c: meilleur_candidat_par_cluster[c][1], reverse=True)
noms_pris, NOMS_CLUSTERS = set(), {}
for cid in ordre_affectation:
    nom_candidat, score = meilleur_candidat_par_cluster[cid]
    if score[0] >= SEUIL_MATCH_CANDIDATE and nom_candidat not in noms_pris:
        NOMS_CLUSTERS[cid] = nom_candidat
        noms_pris.add(nom_candidat)
    else:
        NOMS_CLUSTERS[cid] = nom_automatique(cid)

noms_deja_utilises = set()
for cid in range(K_RETENU):
    nom, suffixe = NOMS_CLUSTERS[cid], 2
    nom_final = nom
    while nom_final in noms_deja_utilises:
        nom_final = '{} ({})'.format(nom, suffixe)
        suffixe += 1
    noms_deja_utilises.add(nom_final)
    NOMS_CLUSTERS[cid] = nom_final

df['famille'] = df['cluster'].map(NOMS_CLUSTERS)

print('Familles retenues :')
for cid, nom in NOMS_CLUSTERS.items():
    n_gab = df[df['cluster'] == cid]['num_automate'].nunique()
    candidat, score = meilleur_candidat_par_cluster[cid]
    origine = 'candidate (score {}/{})'.format(score[0], len(FAMILLES_CANDIDATES.get(candidat, [1]))) \
        if nom == candidat else 'nommage automatique'
    print('  Cluster {} -> "{}" ({} GAB) - {}'.format(cid, nom, n_gab, origine))
