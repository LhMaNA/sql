# Selection des features de clustering + exclusion des valeurs extremes + normalisation
# ══════════════════════════════════════════════════════════════════════════════
# 'pct_reseaux_etrangers' remplace par 'log_pct_reseaux_etrangers' (voir feature
# engineering) - la version brute ecrasait le signal touristique au lieu de le
# reveler. 'score_horaires_atypiques' toujours absent (redondant avec nuit+weekend).
FEAT_CLUST = [
    'ret_pct_nuit', 'ret_pct_weekend', 'log_pct_reseaux_etrangers',
    'log_ret_nb_horscos', 'ret_montant_moyen', 'taux_capture_pct',
    'cv_montant', 'concentration_reseau',
    'zone_touristique_connue', 'zone_rurale_connue',
]
FEAT_CLUST = [f for f in FEAT_CLUST if f in df.columns]
print('Features de clustering ({}) : {}'.format(len(FEAT_CLUST), FEAT_CLUST))

# Exclusion des valeurs EXTREMES avant de choisir k et fitter le clustering des
# FAMILLES - desormais sur la version LOG de pct_reseaux_etrangers (moins sensible
# aux quelques GAB legerement plus touristiques, qui ne sont pas des incidents mais
# un vrai profil a laisser dans la population normale).
COLONNES_NUMERIQUES_POUR_EXCLUSION = [
    f for f in FEAT_CLUST if f not in ('zone_touristique_connue', 'zone_rurale_connue')
]
masque_extreme_par_colonne = pd.DataFrame({
    col: df[col] > df[col].quantile(0.995)
    for col in COLONNES_NUMERIQUES_POUR_EXCLUSION
})
masque_population_normale = ~masque_extreme_par_colonne.any(axis=1)
n_extremes = (~masque_population_normale).sum()
if n_extremes > 0:
    print('{} observations extremes exclues du CHOIX DE k (pas de l\'analyse) - '
          'extreme sur au moins un des {} criteres (seuil : 99,5e percentile de '
          'chaque critere).'.format(n_extremes, len(COLONNES_NUMERIQUES_POUR_EXCLUSION)))

X = df[FEAT_CLUST].fillna(0)
scaler_clust = RobustScaler()
scaler_clust.fit(X[masque_population_normale])
X_scaled = scaler_clust.transform(X)
